# Public client-side variables (safe to expose in browser bundle)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_FUNCTIONS_SLUG=make-server-668731fc

# Figma sync/push automation
# FIGMA_ACCESS_TOKEN=your_figma_personal_access_token
# FIGMA_FILE_KEY=your_figma_file_key
# FIGMA_COMPONENT_NODE_IDS=12:34,56:78
# FIGMA_EXPORT_FORMAT=png
# FIGMA_EXPORT_SCALE=2
# FIGMA_PUSH_MESSAGE=Auto sync update from CI
# FIGMA_COMMENT_X=0
# FIGMA_COMMENT_Y=0

# Server-side only secrets: set these only in Vercel/Supabase secret stores, never in client env files
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=
# PAYSTACK_SECRET_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# CLEANUP_SECRET_KEY=
